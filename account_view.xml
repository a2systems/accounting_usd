<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="accounting_usd_account_account_tree" model="ir.ui.view">
	<field name="name">accounting_usd.account.account.tree</field>
        <field name="model">account.account</field>
        <field name="inherit_id" ref="account.view_account_list"></field>
	<field name="arch" type="xml">
		<field name="name" position="after">
			<field name="balance_usd" optional="hide"/>
		</field>
        </field>
    </record>


    <record id="accounting_usd_account_move_line_tree" model="ir.ui.view">
	<field name="name">accounting_usd.account.move.line.tree</field>
        <field name="model">account.move.line</field>
        <field name="inherit_id" ref="account.view_move_line_tree"></field>
	<field name="arch" type="xml">
		<field name="sequence" position="after">
			<field name="debit_usd" optional="hide"/>
			<field name="credit_usd" optional="hide"/>
			<field name="usd_rate" optional="hide"/>
			<field name="balance_usd" optional="hide"/>
			<field name="running_balance_usd" optional="hide"/>
		</field>
        </field>
    </record>


</odoo>
